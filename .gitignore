# ════════════════════════════════════════════════════════════════════
#  SmartCanteen — .gitignore   (Day 9: the Golden Rule — never commit secrets)
# ════════════════════════════════════════════════════════════════════

# ---- Secrets & local config ----
.env
.env.local

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# ---- Virtual environments ----
venv/
.venv/
env/

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editor / IDE ----
.vscode/
.idea/
*.swp

# ---- Logs & temp ----
*.log
*.pid
