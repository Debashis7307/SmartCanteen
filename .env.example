# ════════════════════════════════════════════════════════════════════
#  SmartCanteen — Environment Variables (EXAMPLE — copy to .env)
# ════════════════════════════════════════════════════════════════════
#  HOW TO USE:
#     1. Copy this file:   cp .env.example .env        (Windows: copy)
#     2. Fill in real values
#     3. NEVER commit the real .env  (it is in .gitignore)
#
#  WHY THIS EXISTS  (Day 3 OS Concepts + Day 9 Git/Deployment):
#     The .env file is NOT an OS feature. The python-dotenv library
#     reads this text file and injects the values into the process's
#     environment variables. Secrets stay out of source code & git!
# ════════════════════════════════════════════════════════════════════

# MongoDB connection string.
# Local dev:        mongodb://localhost:27017
# Cloud (Atlas):    mongodb+srv://<user>:<pass>@cluster0.xxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017

# The database name inside MongoDB. One Mongo server, many databases.
MONGO_DB_NAME=smart_canteen

# Secret key used to SIGN our JWTs (Day 5). Anyone who knows this can
# forge valid login tokens — so it MUST stay secret & random.
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_secret_string

# How many hours a login JWT stays valid before the student must log in again.
JWT_EXPIRY_HOURS=12

# Which origin(s) are allowed to call our API cross-origin (Day 4: CORS).
# In production this would be your Render URL.
CORS_ORIGINS=http://localhost:5000,https://smartcanteen.onrender.com

# 0.0.0.0 = listen on ALL network interfaces  (Day 2: TCP/Ports)
# This lets other devices on the same WiFi open the app via your IP.
HOST=0.0.0.0
PORT=5000
FLASK_ENV=development
